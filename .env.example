# ============================================================
# Share Historys — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# --- Telegram Bot API (node-telegram-bot-api) ---
# Get from @BotFather: https://t.me/BotFather
# Enable "Business Mode" for the bot via @BotFather -> /mybots -> Bot Settings
TELEGRAM_BOT_TOKEN=

# Business Connection ID — obtained when a Telegram Business account
# links your bot via Settings -> Telegram Business -> Chatbots
# The bot receives a business_connection update with this ID.
TELEGRAM_BUSINESS_CONNECTION_ID=

# --- Telegram MTProto (GramJS) — for reading stories ---
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Phone number for the user account that reads stories
TELEGRAM_PHONE_NUMBER=

# Session string for GramJS (auto-generated on first run, stored here for reuse)
TELEGRAM_SESSION_STRING=

# Comma-separated list of Telegram usernames/channels to monitor for stories
# Example: @channel1,@username2
TELEGRAM_MONITORED_PEERS=

# --- Instagram (instagram-private-api) ---
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Path to store Instagram session (for persistent login)
INSTAGRAM_SESSION_PATH=./data/instagram_session.json

# Comma-separated list of Instagram usernames to monitor for stories
INSTAGRAM_MONITORED_USERS=

# --- Instagram Official Graph API (optional, for hybrid mode) ---
# Facebook App ID and Secret from https://developers.facebook.com
INSTAGRAM_GRAPH_APP_ID=
INSTAGRAM_GRAPH_APP_SECRET=

# Instagram Business/Creator account ID (numeric, from Graph API)
INSTAGRAM_GRAPH_ACCOUNT_ID=

# Long-lived access token (60 days, refresh before expiry)
INSTAGRAM_GRAPH_ACCESS_TOKEN=

# --- General ---
# Polling interval in seconds (how often to check for new stories)
POLL_INTERVAL_SECONDS=120

# Path to SQLite database for tracking processed stories
DATABASE_PATH=./data/state.db

# Directory for temporary media downloads
TEMP_DIR=./data/temp

# Log level: error | warn | info | debug
LOG_LEVEL=info
