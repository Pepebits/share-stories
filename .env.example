# ============================================================
# Share Historys — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# --- Telegram MTProto (GramJS) — reads the source stories ---
# Get api_id / api_hash from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Phone number of the user account that reads stories (E.164, e.g. +34600000000)
TELEGRAM_PHONE_NUMBER=

# Optional. Leave it empty and the bridge reads the session file below, which
# `pnpm run login` writes. Set it only if you would rather keep the session in
# .env — note that environment variables show up in `docker inspect`.
TELEGRAM_SESSION_STRING=

# Where the Telegram session lives. `pnpm run login` writes it here (mode
# 0600); the bridge reads it back on every start. Only needed if you want a
# different path.
# TELEGRAM_SESSION_FILE=./data/telegram-session.txt

# Comma-separated Telegram usernames/channels to monitor
# Example: @channel1,@username2
TELEGRAM_MONITORED_PEERS=

# --- Instagram Content Publishing (official API) ---
# "Instagram API with Instagram Login" — requires an Instagram
# Business or Creator account. No Facebook Page needed.
#
# Numeric Instagram professional account id
INSTAGRAM_ACCOUNT_ID=

# Long-lived access token. Expires after 60 days, but the app refreshes it
# automatically once fewer than 14 days remain and stores the result in the
# file below — so this value is only the starting point of the chain.
# Paste a new token here to override a stored one (the app notices the change
# and discards the old chain).
INSTAGRAM_ACCESS_TOKEN=

# Where the current (refreshed) token is kept, written with mode 0600.
INSTAGRAM_TOKEN_FILE=./data/instagram-token.json

# Instagram allows 100 API publishes per rolling 24h, and stories DO count
# (confirmed against the live API). Hold some back to keep posting by hand
# while the bridge runs; 0 means the bridge may use the whole quota.
INSTAGRAM_QUOTA_RESERVE=0

# How long a quota reading is trusted before asking Meta again.
INSTAGRAM_QUOTA_REFRESH_SECONDS=600

# --- Public media server ---
# Meta does not accept file uploads: it downloads the story from a URL you
# expose. This MUST be reachable from the public internet, and HTTPS is
# strongly recommended (put nginx/Caddy in front of the port below).
# Startup fails if this points at localhost or a private range.
PUBLIC_BASE_URL=https://stories.example.com

# Interface and port the internal HTTP server binds to.
# Keep the default loopback bind and let the reverse proxy handle TLS.
MEDIA_SERVER_HOST=127.0.0.1
MEDIA_SERVER_PORT=8080

# How long a media URL stays valid. It is revoked as soon as Meta has
# fetched it; this is only a backstop for failed publishes.
MEDIA_URL_TTL_SECONDS=600

# --- General ---
# How often to check for new stories, in seconds
# Which Telegram story audiences may be republished to Instagram.
#
# DEFAULT IS EVERYTHING, INCLUDING CLOSE-FRIENDS STORIES. Read this before
# leaving it that way.
#
# Instagram's publishing API has NO audience parameter: every story it
# publishes goes to all your followers, and there is no close-friends
# equivalent to publish into. So a Telegram story restricted to close friends
# does not stay restricted when it crosses — it becomes public. The bridge
# cannot narrow it; it can only decline to carry it.
#
# Values: public, contacts, selectedContacts, closeFriends — or 'all'.
#
#   TELEGRAM_STORY_SCOPES=public    only what was already open to everyone
#   TELEGRAM_STORY_SCOPES=all       everything (the default)
#
# Set this to 'public' if TELEGRAM_MONITORED_PEERS names anyone but yourself.
# Their close-friends stories are not yours to make public.
TELEGRAM_STORY_SCOPES=all

POLL_INTERVAL_SECONDS=120

# Consecutive publish failures before the bridge messages you in your own
# Telegram Saved Messages. It sends one message when publishing breaks and one
# when it recovers, never a message per failure. Set to 0 to turn it off.
#
# Worth leaving on: this runs unattended, and a break that only shows up in the
# log is a break nobody sees.
ALERT_AFTER_FAILURES=3

# SQLite database tracking processed stories (prevents duplicates)
DATABASE_PATH=./data/state.db

# Directory for temporary media downloads
TEMP_DIR=./data/temp

# Log level: error | warn | info | debug
LOG_LEVEL=info

# --- Docker only ---
# Where compose publishes the media port. Loopback by default so a reverse
# proxy on the same host can reach it and the internet cannot.
BRIDGE_BIND=127.0.0.1
BRIDGE_PORT=8080

# Only for `docker compose --profile tunnel`
CLOUDFLARE_TUNNEL_TOKEN=
