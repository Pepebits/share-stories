# Endurecimiento de la instalación (pnpm 10)

# No ejecutar scripts de instalación salvo los de la lista blanca
# `pnpm.onlyBuiltDependencies` en package.json.
side-effects-cache=false

# Rechaza paquetes publicados hace menos de 7 días: mitiga los ataques de
# cadena de suministro en los que se publica una version troyanizada y se
# retira a las pocas horas.
minimum-release-age=10080

# node_modules estricto: una dependencia transitiva NO es importable si no
# está declarada en package.json.
hoist=false
strict-peer-dependencies=false

# Verifica la integridad del store en cada instalación.
verify-store-integrity=true
