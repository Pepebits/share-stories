[Unit]
Description=share-stories — Telegram → Instagram story bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=share-stories
WorkingDirectory=/opt/share-stories
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=share-stories

# Security hardening
NoNewPrivileges=yes
# Files the service creates (session, token, database) are owner-only by default.
UMask=0077
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/share-stories/data
ReadOnlyPaths=/opt/share-stories/.env

# Environment
Environment=NODE_ENV=production
EnvironmentFile=/opt/share-stories/.env

[Install]
WantedBy=multi-user.target
