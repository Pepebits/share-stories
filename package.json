{
  "name": "share-stories",
  "version": "1.0.0",
  "description": "Reposts Telegram stories to Instagram through the official Content Publishing API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write \"{src,test,scripts}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.ts\"",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run build && pnpm test && pnpm audit --prod",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "login": "tsx scripts/telegram-login.ts",
    "inspect": "tsx scripts/telegram-inspect.ts"
  },
  "keywords": [
    "telegram",
    "instagram",
    "stories",
    "automation",
    "cross-posting"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": ">=24.19"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "telegram": "^2.26.22",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "globals": "^17.9.0",
    "prettier": "^3.4.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
